# ==============================================================================
# TrustTrace Environment Configuration
# ==============================================================================

# Application Meta
PROJECT_NAME="TrustTrace"
ENVIRONMENT="development"
DEBUG=true

# Demonstration Mode (True enables full synthetic lab benchmark scenarios without paid API keys)
DEMO_MODE=true

# Security & Secrets (Change in production!)
SECRET_KEY="trusttrace-secure-local-dev-key-change-in-production-min32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite local mode by default, or PostgreSQL)
# Example PostgreSQL: postgresql://trusttrace:password@localhost:5432/trusttrace
DATABASE_URL="sqlite:///./trusttrace.db"

# AI Provider ("demo" | "mistral" | "gemini" | "openai")
AI_PROVIDER="demo"

# External AI Provider Credentials (Optional - system gracefully falls back to deterministic engine when missing)
MISTRAL_API_KEY=""
MISTRAL_MODEL="open-mistral-7b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Threat Intelligence Feeds (Optional)
GOOGLE_SAFE_BROWSING_API_KEY=""
URLHAUS_API_KEY=""

# Outbound SSRF & Safe Request Constraints
MAX_OUTBOUND_TIMEOUT_SECONDS=3.0
MAX_RESPONSE_BYTES=65536
